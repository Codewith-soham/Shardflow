{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true, //makes easier for ts to work with packages written using common js while we use ES modules
    "skipLibCheck": true, //dont check the declaration file of installed libraries
    "forceConsistentCasingInFileNames": true, //prevents problems caused by different capitalization of filenames/import
    "resolveJsonModule": true, //allows ts to import json files as modules 
    "sourceMap": true, //
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true, //prevents accidental switch-case falthrough
    "isolatedModules": true //each file is treated as a seperate module
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}