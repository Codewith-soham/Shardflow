# ShardFlow Backend — Environment Variables
# Copy this file to .env and fill in the values.

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=shardflow

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Frontend page that password-reset emails link to (must be in Supabase redirect allow-list)
PASSWORD_RESET_REDIRECT_URL=http://localhost:5173/reset-password

# Security & Shard Encryption (64-char hex string)
SHARD_ENCRYPTION_KEY=your_64_character_hex_encryption_key
